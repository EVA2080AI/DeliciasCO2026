# Credenciales públicas de Supabase: viajan en el bundle a cada visitante por diseño,
# y lo que protege los datos es RLS. La service-role key NUNCA va en un VITE_.
# Sin estas dos el build falla a propósito (plugin require-supabase-env en vite.config.ts).
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"

# Alias opcional: si no está PUBLISHABLE_KEY, client.ts toma esta. Basta con una de las dos.
VITE_SUPABASE_ANON_KEY="your-anon-key"
